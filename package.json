{
  "name": "@theisegoria/game-asset-mcp",
  "version": "0.3.1",
  "description": "MCP server for an agentic game-asset generation pipeline: reference images to 3D models with PBR textures, plus retexturing meshes you already own.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "3d",
    "game-assets",
    "pbr",
    "tripo",
    "leonardo",
    "gltf",
    "glb",
    "text-to-3d",
    "image-to-3d"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "game-asset-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "scripts/*.py",
    "scripts/*.mjs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests scripts",
    "verify": "npm run build && node scripts/verify-install.mjs",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theisegoria/game-asset-mcp.git"
  },
  "homepage": "https://github.com/theisegoria/game-asset-mcp#readme",
  "bugs": {
    "url": "https://github.com/theisegoria/game-asset-mcp/issues"
  }
}
