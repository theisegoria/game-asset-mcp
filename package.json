{
  "name": "@theisegoria/game-development-studio",
  "version": "1.0.1",
  "description": "Local-first CLI and native macOS studio for game-asset production, deterministic captures, visual debugging, and performance analysis.",
  "keywords": [
    "game-development",
    "cli",
    "macos",
    "blender",
    "3d",
    "game-assets",
    "pbr",
    "tripo",
    "leonardo",
    "gltf",
    "glb",
    "text-to-3d",
    "image-to-3d"
  ],
  "license": "MIT",
  "author": "Benjamin Michael Haire",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "game-dev": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "scripts/*.py",
    "scripts/*.mjs",
    "distribution/skills-repo",
    "adapters",
    "skills",
    ".codex-plugin",
    "assets/icon.png",
    "assets/icon-provenance.json",
    "assets/screenshots",
    "docs",
    "marketing/COPY.md",
    "marketing/STORE_SUBMISSION.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "PRIVACY.md",
    "SECURITY.md",
    "SUPPORT.md",
    "TERMS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests scripts",
    "verify": "npm run build && node scripts/verify-install.mjs && node scripts/verify-plugin.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run verify"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theisegoria/game-development-studio.git"
  },
  "homepage": "https://github.com/theisegoria/game-development-studio#readme",
  "bugs": {
    "url": "https://github.com/theisegoria/game-development-studio/issues"
  }
}
