# A REFERENCE LIST, not a file the server reads.
#
# There is no dotenv dependency: the server reads process.env and nothing else,
# so a .env file on disk does nothing on its own. Either export these in the
# shell that launches the server, or — better — set them in your MCP client's
# `env` block, which is the only place that reliably reaches the child process.
# Never commit real keys.
#
# Credentials are validated LAZILY: the server starts with only one provider
# configured, and tools belonging to the missing provider return a clear
# configuration error instead of failing at startup.

# --- 3D generation (Tripo) -------------------------------------------------
# Create a key at https://platform.tripo3d.ai
# NOTE: Tripo API credits are billed SEPARATELY from a Tripo Studio web
# subscription. A Studio plan does not fund API calls.
TRIPO_API_KEY=

# --- Image generation (Leonardo.Ai) ---------------------------------------
# Create a key at https://app.leonardo.ai (API access required)
LEONARDO_API_KEY=

# --- Workspace -------------------------------------------------------------
# Where downloaded assets and the job database are written.
# Defaults to ./assets/generated relative to the server's working directory.
ASSET_OUTPUT_DIR=

# --- Optional tuning -------------------------------------------------------
# Max bytes for any single download (default 268435456 = 256 MiB)
ASSET_MAX_DOWNLOAD_BYTES=
# Per-request HTTP timeout in milliseconds (default 60000)
ASSET_HTTP_TIMEOUT_MS=
# Log level: silent | error | warn | info | debug (default info)
ASSET_LOG_LEVEL=

# Session spend ceiling in US cents. Credit-consuming tools refuse once it is
# reached, before contacting the provider at all. Unset means no ceiling.
# ASSET_SPEND_LIMIT_CENTS=

# Blender executable for normalize_mesh and batch_prepare_meshes. Auto-detected;
# on macOS the app bundle is not on PATH, so set this if discovery fails.
# BLENDER_PATH=

# Retarget the 3D provider. Must be https:// — an http:// value is refused when
# the provider is first used, because the upload carries your API key.
# TRIPO_BASE_URL=

# Retarget the image/audio provider. Must be https://, same reason.
# LEONARDO_BASE_URL=

# Override the default Leonardo image model. Per-call modelId also exists.
# LEONARDO_MODEL_ID=
