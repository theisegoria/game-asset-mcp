# Reference only. Game Development Studio reads process.env; it does not load
# this file. Export values in the shell that starts `game-dev`, or let the
# forthcoming native app supply credentials from Keychain. Never commit keys.

# Provider credentials are optional and checked only when their provider is
# invoked. `game-dev credentials status --json` reports configured/missing
# without returning values.
TRIPO_API_KEY=
LEONARDO_API_KEY=

# Asset workspace. Defaults to ./assets/generated in the current directory.
ASSET_OUTPUT_DIR=

# Durable jobs, canonical packages, captures, and the derived catalog.
# Defaults to $ASSET_OUTPUT_DIR/.game-dev.
GAME_DEV_DATA_ROOT=

# Maximum bytes accepted for one download (default: 268435456 / 256 MiB).
ASSET_MAX_DOWNLOAD_BYTES=

# Per-request network timeout in milliseconds (default: 60000).
ASSET_HTTP_TIMEOUT_MS=

# Set to `off` to stop caching reference candidate images under
# <ASSET_OUTPUT_DIR>/.thumbnails. Caching is on by default: the fetches are free
# against a generation already paid for, the provider URLs expire, and a caller
# that cannot fetch arbitrary URLs -- which is every MCP client -- otherwise
# never sees the candidates it is being asked to choose between.
ASSET_REFERENCE_THUMBNAILS=

# Optional session-wide estimated spend ceiling in US cents. Paid operations
# still require --approve-spend and --spend-limit-cents for each invocation.
ASSET_SPEND_LIMIT_CENTS=

# silent | error | warn | info | debug (default: info). Logs go to stderr.
ASSET_LOG_LEVEL=

# Optional Blender executable override. macOS app-bundle discovery is built in.
BLENDER_PATH=

# Development/test endpoint overrides. HTTPS is required because requests can
# carry credentials. Most users should leave these unset.
TRIPO_BASE_URL=
LEONARDO_BASE_URL=

# Optional Leonardo image model override. A request-level modelId wins.
LEONARDO_MODEL_ID=
